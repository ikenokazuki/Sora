#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# Sora CLI - Command Line Client for Sora Engine (Port 3016)
# ==============================================================================

BASE_URL="${SORA_API_URL:-http://127.0.0.1:3016}"
API_KEY="${SORA_API_KEY:-}"

usage() {
  cat <<'EOF'
Sora CLI - 高性能 Web スクレイピング & 日本語検索エンジン

Usage:
  sora <command> [arguments...] [options]

Commands:
  search <query>         統合深層検索 (Web検索 + 上位本文スクレイプ + Xリアルタイム速報)
  web <query>            基本Web検索 (タイトル・概要スニペット・URL一覧)
  scrape <url>           単一URL / PDF 本文抽出 (Markdown変換)
  browser-action <url>   Stealth Chromiumでページを開く (複雑な操作はMCP経由を推奨)
  batch <url1> <url2>..  複数URL並行スクレイプ
  crawl <url>            同一ドメイン内再帰クロール
  map <url>              サイトマップ / リンク探索
  realtime <query>       X (旧 Twitter) リアルタイム速報・ポスト一覧
  trend                  いま話題の急上昇トレンドランキング Top 20
  news <query>           Yahoo! ニュース記事検索
  chiebukuro <query>     Yahoo! 知恵袋 Q&A 検索
  suggest <query>        検索サジェスト・共起キーワード取得
  image <query>          Yahoo! 画像検索
  video <query>          Yahoo! 動画検索
  weather <city>         気象庁 天気予報・気温・降水確率取得 (例: "千代田区", "天童市")
  transit <from> <to>    乗換案内 (出発駅・到着駅)
  traffic <pref> [road]  日本道路交通情報 (規制・事故・渋滞)
  flight [airport]       主要空港フライト運航状況・欠航・遅延 (例: "羽田", "成田", "伊丹")
  elevation <address>    国土地理院 標高 (海抜) & 座標取得 (例: "東京都千代田区永田町1-7-1")
  diet <query>           国会会議録 全文検索 (衆参両院の本会議・委員会答弁)
  disaster [city]        気象警報・注意報 (市町村指定)
  earthquake             最近の地震情報 (震度・震源地)
  music <query>          iTunes 音楽・楽曲・アーティスト検索 (汎用)
  song <query>           iTunes 曲名指定 楽曲検索
  artist <query>         iTunes アーティスト指定 検索
  laws <query>           e-Gov 法令・条文検索
  law-text <lawId>       e-Gov 法令ID指定 条文本文取得
  cpsc-check <hts> <age> 米国CPSC適合証明書(GCC/CCC) eFiling義務化判定 (age: adult|child|unknown)
  fda-check <hts>        米国FDA規制対象 簡易判定 (HS Chapter単位)
  hts-verify <hts> <desc> HTS/HSコード実在確認・検証 (USITC公式データ照合、descは製品説明必須)
  watch <subcommand>     ページ差分監視 (list | check [id] | delete <id> | register <url>)
  health                 サーバー稼働状態 & 依存関係ステータス確認
  tools [query]          利用可能なツール一覧・検索

Options:
  --limit <num>          取得件数 / ページ数の指定
  --prompt               LLM プロンプト用 XML タグ形式で出力
  --json                 生 JSON 形式で出力
  -h, --help             ヘルプを表示

Environment Variables:
  SORA_API_URL           API サーバーのベース URL (デフォルト: http://127.0.0.1:3016)
  SORA_API_KEY           API キー (認証有効時)

Examples:
  sora search "TypeScript 5.5 新機能" --limit 3
  sora scrape "https://example.com/article" --prompt
  sora weather "千代田区"
  sora transit "新宿" "渋谷"
  sora realtime "地震"
EOF
  exit 0
}

format_output() {
  if command -v jq >/dev/null 2>&1; then
    jq .
  elif command -v bun >/dev/null 2>&1; then
    bun -e 'process.stdin.text().then(t=>{try{console.log(JSON.stringify(JSON.parse(t),null,2))}catch{console.log(t)}})'
  elif command -v node >/dev/null 2>&1; then
    node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{console.log(JSON.stringify(JSON.parse(d),null,2))}catch{console.log(d)}})'
  else
    cat
  fi
}

call_sora() {
  local endpoint="$1"
  local json_payload="${2:-}"
  local headers=(
    -H "Content-Type: application/json"
    -H "Accept: application/json"
  )
  if [[ -n "$API_KEY" ]]; then
    headers+=(-H "x-api-key: $API_KEY")
  fi

  if [[ -n "$json_payload" ]]; then
    curl -s -f -X POST "${BASE_URL}${endpoint}" "${headers[@]}" -d "$json_payload" | format_output
  else
    curl -s -f -X GET "${BASE_URL}${endpoint}" "${headers[@]}" | format_output
  fi
}

if [[ $# -eq 0 ]]; then
  usage
fi

CMD="$1"
shift

case "$CMD" in
  -h|--help|help)
    usage
    ;;

  search)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora search 'TypeScript'" >&2; exit 1; fi
    QUERY="$1"
    shift
    LIMIT=5
    FORMAT_PROMPT=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --limit) LIMIT="$2"; shift 2 ;;
        --prompt) FORMAT_PROMPT=true; shift ;;
        *) shift ;;
      esac
    done
    PAYLOAD=$(printf '{"query":%s,"limit":%d,"scrapeContent":true,"includeRealtime":true,"formatAsPrompt":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")" \
      "$LIMIT" \
      "$FORMAT_PROMPT")
    call_sora "/search" "$PAYLOAD"
    ;;

  web)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora web 'TypeScript'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"query":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/search/web" "$PAYLOAD"
    ;;

  scrape)
    if [[ $# -eq 0 ]]; then echo "Error: URL required. e.g. sora scrape 'https://example.com'" >&2; exit 1; fi
    URL="$1"
    shift
    MAX_CHARS=20000
    FORMAT_PROMPT=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --max-chars) MAX_CHARS="$2"; shift 2 ;;
        --prompt) FORMAT_PROMPT=true; shift ;;
        *) shift ;;
      esac
    done
    PAYLOAD=$(printf '{"url":%s,"maxChars":%d,"formatAsPrompt":%s}' \
      "$(echo "$URL" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$URL")" \
      "$MAX_CHARS" \
      "$FORMAT_PROMPT")
    call_sora "/scrape" "$PAYLOAD"
    ;;

  browser-action)
    if [[ $# -eq 0 ]]; then echo "Error: URL required. e.g. sora browser-action 'https://example.com'" >&2; exit 1; fi
    URL="$1"
    shift
    PAYLOAD=$(printf '{"url":%s}' \
      "$(echo "$URL" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$URL")")
    call_sora "/browser/action" "$PAYLOAD"
    ;;

  batch)
    if [[ $# -eq 0 ]]; then echo "Error: URLs required. e.g. sora batch 'https://a.com' 'https://b.com'" >&2; exit 1; fi
    URLS_JSON=$(printf '%s\n' "$@" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim().split("\n").filter(Boolean))))' 2>/dev/null || echo "[]")
    PAYLOAD=$(printf '{"urls":%s}' "$URLS_JSON")
    call_sora "/scrape/batch" "$PAYLOAD"
    ;;

  map)
    if [[ $# -eq 0 ]]; then echo "Error: URL required. e.g. sora map 'https://example.com'" >&2; exit 1; fi
    URL="$1"
    shift
    PAYLOAD=$(printf '{"url":%s}' \
      "$(echo "$URL" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$URL")")
    call_sora "/map" "$PAYLOAD"
    ;;

  crawl)
    if [[ $# -eq 0 ]]; then echo "Error: URL required. e.g. sora crawl 'https://example.com/docs'" >&2; exit 1; fi
    URL="$1"
    shift
    MAX_PAGES=10
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --limit|--max-pages) MAX_PAGES="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    PAYLOAD=$(printf '{"url":%s,"maxPages":%d}' \
      "$(echo "$URL" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$URL")" \
      "$MAX_PAGES")
    call_sora "/crawl" "$PAYLOAD"
    ;;

  realtime)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora realtime '速報'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"query":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/search/realtime" "$PAYLOAD"
    ;;

  trend)
    call_sora "/search/trend" "{}"
    ;;

  news)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora news 'AI'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"query":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/search/news" "$PAYLOAD"
    ;;

  chiebukuro)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora chiebukuro 'NixOS'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"query":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/search/chiebukuro" "$PAYLOAD"
    ;;

  suggest)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora suggest 'Python'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"query":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/search/suggest" "$PAYLOAD"
    ;;

  image)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora image '富士山'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"query":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/search/image" "$PAYLOAD"
    ;;

  video)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora video '富士山'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"query":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/search/video" "$PAYLOAD"
    ;;

  weather)
    if [[ $# -eq 0 ]]; then echo "Error: city name required. e.g. sora weather '千代田区' or sora weather '天童市'" >&2; exit 1; fi
    CITY="$1"
    shift
    PAYLOAD=$(printf '{"city":%s}' \
      "$(echo "$CITY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$CITY")")
    call_sora "/weather" "$PAYLOAD"
    ;;

  transit)
    if [[ $# -lt 2 ]]; then echo "Error: from and to required. e.g. sora transit '新宿' '渋谷'" >&2; exit 1; fi
    FROM="$1"
    TO="$2"
    shift 2
    PAYLOAD=$(printf '{"from":%s,"to":%s}' \
      "$(echo "$FROM" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$FROM")" \
      "$(echo "$TO" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$TO")")
    call_sora "/transit/route" "$PAYLOAD"
    ;;

  traffic)
    if [[ $# -eq 0 ]]; then echo "Error: prefecture required. e.g. sora traffic '東京都' or sora traffic '山形県' '東北道'" >&2; exit 1; fi
    PREF="$1"
    ROAD="${2:-}"
    if [[ -n "$ROAD" ]]; then
      PAYLOAD=$(printf '{"prefecture":%s,"road":%s}' \
        "$(echo "$PREF" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$PREF")" \
        "$(echo "$ROAD" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$ROAD")")
    else
      PAYLOAD=$(printf '{"prefecture":%s}' \
        "$(echo "$PREF" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$PREF")")
    fi
    call_sora "/traffic/road" "$PAYLOAD"
    ;;

  flight)
    AIRPORT="${1:-羽田}"
    FLIGHT_NUM="${2:-}"
    if [[ -n "$FLIGHT_NUM" ]]; then
      PAYLOAD=$(printf '{"airport":%s,"flightNumber":%s}' \
        "$(echo "$AIRPORT" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$AIRPORT")" \
        "$(echo "$FLIGHT_NUM" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$FLIGHT_NUM")")
    else
      PAYLOAD=$(printf '{"airport":%s}' \
        "$(echo "$AIRPORT" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$AIRPORT")")
    fi
    call_sora "/traffic/flight" "$PAYLOAD"
    ;;

  elevation|geocode)
    if [[ $# -eq 0 ]]; then echo "Error: address required. e.g. sora elevation '東京都千代田区永田町1-7-1'" >&2; exit 1; fi
    ADDR="$1"
    shift
    PAYLOAD=$(printf '{"address":%s}' \
      "$(echo "$ADDR" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$ADDR")")
    call_sora "/geo/elevation" "$PAYLOAD"
    ;;

  diet|kokkai)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora diet '人工知能'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"keyword":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/gov/diet-minutes" "$PAYLOAD"
    ;;

  disaster)
    CITY="${1:-}"
    if [[ -n "$CITY" ]]; then
      PAYLOAD=$(printf '{"city":%s}' \
        "$(echo "$CITY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$CITY")")
      call_sora "/disaster/warnings" "$PAYLOAD"
    else
      call_sora "/disaster/earthquake" "{}"
    fi
    ;;

  earthquake)
    call_sora "/disaster/earthquake" "{}"
    ;;

  music)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora music 'YOASOBI'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"query":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/search/music" "$PAYLOAD"
    ;;

  song)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora song 'アイドル'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"query":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/search/song" "$PAYLOAD"
    ;;

  artist)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora artist 'YOASOBI'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"query":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/search/artist" "$PAYLOAD"
    ;;

  laws)
    if [[ $# -eq 0 ]]; then echo "Error: query required. e.g. sora laws '著作権法'" >&2; exit 1; fi
    QUERY="$1"
    shift
    PAYLOAD=$(printf '{"keyword":%s}' \
      "$(echo "$QUERY" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$QUERY")")
    call_sora "/gov/laws" "$PAYLOAD"
    ;;

  law-text)
    if [[ $# -eq 0 ]]; then echo "Error: lawId required. e.g. sora law-text '129AC0000000089'" >&2; exit 1; fi
    LAW_ID="$1"
    shift
    PAYLOAD=$(printf '{"lawId":%s}' \
      "$(echo "$LAW_ID" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$LAW_ID")")
    call_sora "/gov/law-text" "$PAYLOAD"
    ;;

  cpsc-check)
    if [[ $# -lt 2 ]]; then echo "Error: htsCode and targetAge required. e.g. sora cpsc-check '9503.00.0073' child" >&2; exit 1; fi
    HTS="$1"
    AGE="$2"
    shift 2
    PAYLOAD=$(printf '{"htsCode":%s,"targetAge":%s}' \
      "$(echo "$HTS" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$HTS")" \
      "$(echo "$AGE" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$AGE")")
    call_sora "/trade/cpsc-check" "$PAYLOAD"
    ;;

  fda-check)
    if [[ $# -eq 0 ]]; then echo "Error: htsCode required. e.g. sora fda-check '3004.90.0000'" >&2; exit 1; fi
    HTS="$1"
    shift
    PAYLOAD=$(printf '{"htsCode":%s}' \
      "$(echo "$HTS" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$HTS")")
    call_sora "/trade/fda-check" "$PAYLOAD"
    ;;

  hts-verify)
    if [[ $# -lt 2 ]]; then echo "Error: htsCode and productDescription required. e.g. sora hts-verify '9503.00.0073' 'plastic toy car for children'" >&2; exit 1; fi
    HTS="$1"
    DESC="$2"
    shift 2
    PAYLOAD=$(printf '{"htsCode":%s,"productDescription":%s}' \
      "$(echo "$HTS" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$HTS")" \
      "$(echo "$DESC" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$DESC")")
    call_sora "/trade/hts-verify" "$PAYLOAD"
    ;;

  watch)
    SUB="${1:-list}"
    case "$SUB" in
      list)
        call_sora "/watch/list"
        ;;
      check)
        ID="${2:-}"
        if [[ -n "$ID" ]]; then
          call_sora "/watch/check" "{\"id\":\"$ID\"}"
        else
          call_sora "/watch/check" "{}"
        fi
        ;;
      delete)
        ID="${2:-}"
        if [[ -z "$ID" ]]; then echo "Error: target ID required" >&2; exit 1; fi
        curl -s -f -X DELETE "${BASE_URL}/watch/${ID}" | format_output
        ;;
      register)
        URL="${2:-}"
        if [[ -z "$URL" ]]; then echo "Error: url required. e.g. sora watch register 'https://example.com'" >&2; exit 1; fi
        PAYLOAD=$(printf '{"url":%s}' \
          "$(echo "$URL" | bun -e 'process.stdin.text().then(t=>console.log(JSON.stringify(t.trim())))' 2>/dev/null || printf '"%s"' "$URL")")
        call_sora "/watch/register" "$PAYLOAD"
        ;;
      *)
        echo "Unknown watch subcommand: $SUB (use list, check, delete, register)" >&2
        exit 1
        ;;
    esac
    ;;

  health)
    call_sora "/health?detailed=true"
    ;;

  tools)
    QUERY="${1:-}"
    if [[ -n "$QUERY" ]]; then
      echo "Searching Sora tools for '$QUERY'..."
      # Send search_tools call to MCP endpoint
      curl -s -f -X POST "${BASE_URL}/mcp" \
        -H "Content-Type: application/json" \
        -H "Accept: application/json" \
        -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"search_tools\",\"arguments\":{\"query\":\"$QUERY\"}}}" | format_output
    else
      echo "Listing initial active Sora MCP tools..."
      curl -s -f -X POST "${BASE_URL}/mcp" \
        -H "Content-Type: application/json" \
        -H "Accept: application/json" \
        -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}" | format_output
    fi
    ;;

  *)
    echo "Unknown command: $CMD" >&2
    echo "Run 'sora --help' for usage." >&2
    exit 1
    ;;
esac
