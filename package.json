{
  "name": "web-fetcher",
  "version": "1.0.0",
  "description": "Unified Web Scraping & Markdown Extraction Service with LRU Caching, SSRF Protection, and Browserless Integration",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile server"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.5.0",
    "cheerio": "^1.0.0-rc.12",
    "fast-xml-parser": "^5.11.0",
    "hono": "^4.6.14",
    "linkedom": "^0.18.5",
    "puppeteer-core": "^23.11.1",
    "turndown": "^7.2.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/turndown": "^5.0.5"
  }
}
