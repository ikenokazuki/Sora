{
  "name": "sora",
  "version": "2.51.0",
  "description": "Ultra-fast, lightweight web scraping, deep search, and MCP service (Firecrawl & Tavily Alternative)",
  "type": "module",
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "stdio": "bun run src/stdio.ts",
    "test": "bun test",
    "test:rho-v2-stress": "bun test src/rho_select_v2_stress.test.ts",
    "build": "bun build ./src/index.ts --target=bun --outfile server.js",
    "test:intel:live": "bun run src/services/country_intel/live_smoke.ts",
    "typecheck": "tsc --noEmit",
    "gen:client": "NODE_ENV=test SORA_DB_PATH=:memory: bun --no-env-file scripts/gen-client/index.ts",
    "lint": "biome lint src scripts",
    "test:tools:live": "bun --no-env-file run scripts/tool-health/run.ts --live --image sora-tool-health:candidate --out ./tool-health-out",
    "schema:notation": "NODE_ENV=test SORA_DB_PATH=:memory: bun --no-env-file scripts/schema-notation/scan.ts"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "scraper",
    "firecrawl",
    "tavily",
    "deep-search",
    "stealth-browser",
    "weather",
    "disaster-prevention",
    "traffic"
  ],
  "dependencies": {
    "@geolonia/japanese-numeral": "^1.0.2",
    "@geolonia/normalize-japanese-addresses": "3.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.0",
    "hono": "^4.13.3",
    "linkedom": "^0.18.13",
    "papaparse": "^5.4.1",
    "puppeteer-core": "npm:rebrowser-puppeteer-core@^24.8.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "wreq-js": "^3.2.0",
    "yauzl": "2.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "@types/papaparse": "^5.5.2",
    "@types/turndown": "^5.0.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fast-uri": "^3.1.6"
  }
}
