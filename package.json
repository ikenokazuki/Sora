{
  "name": "sora",
  "version": "2.11.0",
  "description": "Ultra-fast, lightweight web scraping, deep search, and MCP service (Firecrawl & Tavily Alternative)",
  "type": "module",
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "stdio": "bun run src/stdio.ts",
    "test": "bun test",
    "build": "bun build ./src/index.ts --target=bun --outfile server.js"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "scraper",
    "firecrawl",
    "tavily",
    "deep-search",
    "stealth-browser",
    "weather",
    "disaster-prevention",
    "traffic"
  ],
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.0",
    "hono": "^4.13.3",
    "linkedom": "^0.18.13",
    "puppeteer-core": "npm:rebrowser-puppeteer-core@^24.8.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "wreq-js": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/turndown": "^5.0.6"
  }
}
